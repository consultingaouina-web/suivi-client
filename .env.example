# Chaîne aléatoire longue servant à signer les sessions de connexion.
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# C'est la SEULE variable obligatoire pour tester en local (voir plus bas).
SESSION_SECRET=

# Chaîne de connexion à votre cluster MongoDB Atlas (voir le guide de déploiement).
# Laissez-la VIDE pour tester en local : le serveur utilise alors automatiquement
# une base simulée en fichiers JSON (dossier data/, créé tout seul), sans rien
# installer ni configurer d'autre. Remplissez-la uniquement pour déployer en ligne
# (Render + MongoDB Atlas) ou pour tester en local contre la vraie base cloud.
MONGODB_URI=

# Optionnelle — force le mode "fichiers JSON" même si MONGODB_URI est renseignée
# au-dessus (pratique pour continuer à tester en local sans toucher à la vraie
# base). Valeur possible : fichier
DB_MODE=

# Optionnelle — Render fournit automatiquement PORT, ne la renseignez pas sur Render.
PORT=3000
